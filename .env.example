# Copier vers .env (jamais versionné).

# API Studio : adresse du serveur, sans /api/v1.
# Dev : l'API tourne sur l'hôte (compose.yml la joint par host.docker.internal).
# Prod : adresse interne du conteneur de l'API, http://studio-api:8080
NUXT_STUDIO_API_URL=http://localhost:8080
# Slug du site des couteaux dans l'API
NUXT_STUDIO_SITE=couteaux

# Production (compose.prod.yml) : étiquette de l'image ghcr.io/mtek-agency/knife-front (sha-<court> ou latest).
# Pour revenir en arrière : mettre l'ancien sha-… ici dans Dokploy et redéployer.
IMAGE_TAG=latest

# Domaine public des photos (MEDIA_PUBLIC_URL de l'API Studio), lu À LA CONSTRUCTION pour autoriser l'optimisation
# d'images : en local (pnpm dev dans front/) laisser vide ; en CI, variable GitHub du même nom.
MEDIA_PUBLIC_URL=
