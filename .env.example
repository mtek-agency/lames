# Images GHCR (compose.prod.yml) - SHA court ou vX.Y.Z, jamais "latest" seul
# en prod réelle : permet le rollback en changeant juste cette valeur (§3.1 CDCF).
IMAGE_TAG=latest

# PocketBase
PB_ENCRYPTION_KEY=

# Front (Nuxt) - domaine public de service des photos
# Local : http://localhost:8090/api/files (route de fichiers native PocketBase)
# Prod   : https://media.mondomaine.fr (domaine Cloudflare R2, §6.2 CDCF)
NUXT_PUBLIC_MEDIA_BASE_URL=

# Front (Nuxt) - fond de carte MapTiler (§8 Jalon 5)
# Compte gratuit sur https://cloud.maptiler.com (pas de CB requise).
# streets-v2 = point de départ avec de vraies couches colorées (eau, routes,
# parcs, bâtiments), personnalisable visuellement dans MapTiler Cloud — les
# styles "dataviz-*" restent volontairement en niveaux de gris quoi qu'on
# fasse, ce ne sont pas de bons points de départ pour un habillage custom.
NUXT_PUBLIC_MAPTILER_KEY=
NUXT_PUBLIC_MAPTILER_STYLE=streets-v2

# Cloudflare R2 - bucket knives-collection (photos)
R2_COLLECTION_ACCESS_KEY_ID=
R2_COLLECTION_SECRET_ACCESS_KEY=
R2_COLLECTION_BUCKET=knives-collection
R2_ACCOUNT_ID=

# Cloudflare R2 - bucket knives-db-backup (Litestream, à activer plus tard)
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=knives-db-backup

# GitHub Container Registry (Dokploy)
GHCR_READ_PACKAGES_TOKEN=

# Cloudflare API (si automatisation DNS/Access scriptée)
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
